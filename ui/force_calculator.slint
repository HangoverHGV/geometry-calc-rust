import {
    Button,
    GroupBox,
    VerticalBox,
    LineEdit,
    SpinBox,
    HorizontalBox, ComboBox,
} from "std-widgets.slint";

import { Page } from "page.slint";
// Ensure the exported enums are available
export enum SlintForceUnits {
    Newtons,
    Kilonewton,
    KilogramForce,
    MetricTonsForce,
}

export enum SlintMassUnits {
    Kilogram,
    MetricTon,
}

export component ForceCalculator inherits Page {
    title: "Force Elements";
    // 1. Data arrays passed down from AppWindow
    in property <[string]> force-unit-options;
    in property <[string]> mass-unit-options;

    // 2. Outgoing computed results
    in property <string> computed-force;
    in property <string> computed-mpa;

    // 3. Callback to execute the Rust calculation
    callback calculate-force(string, string, string, string);
    // Main calculation function
    function do_calculate() {
        // root.submit_values(total_distance.text, thickness.text, number_of_objects.text);
    }

    GroupBox {

        VerticalBox {
            spacing: 3px;
            alignment: start;
            padding: 10px;

            HorizontalBox {
                alignment: start;
                padding: 0px;
                spacing: 5px;

                // --- Removed the "Calculate" Button entirely ---

                Rectangle {
                    background: red;
                    border-radius: 3px;
                    Button {
                        text: "Clear";
                        clicked => {
                            // total_distance.text = "";
                            // thickness.text = "";
                            // number_of_objects.text = "0";
                            // root.distance = "0";
                            // root.center-distance = "0";
                            
                            // Send cleared states to Rust to reset the output dimensions immediately
                            root.do_calculate();
                        }
                    }
                }
            }

            HorizontalBox {
                VerticalBox {
                    Text {
                        text: "Mass";
                    }

                    mass := LineEdit {
                        placeholder-text: "0.0";
                        text: "";
                        input-type: decimal;
                        // This fires on every single keystroke change!
                        edited => { root.do_calculate(); }
                        accepted => { root.do_calculate(); }
                    }
                }
                mass_unit:= ComboBox {
                    model: root.mass-unit-options;
                    selected(current-value) => { root.do_calculate() }
                }
            }

            thickness := LineEdit {
                placeholder-text: "0.0";
                text: "";
                input-type: decimal;
                // 👇 This fires on every single keystroke change!
                edited => { root.do_calculate(); }
                accepted => { root.do_calculate(); }
            }

            Text {
                text: "Number of Objects (mm): ";
            }

            number_of_objects := LineEdit {
                placeholder-text: "0";
                text: "0";
                input-type: number;
                // 👇 This fires on every single keystroke change!
                edited => { root.do_calculate(); }
                accepted => { root.do_calculate(); }
            }
        }
    }
}

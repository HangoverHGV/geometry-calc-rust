import { SideBar } from "components/side_bar.slint";
import { NumberOfElementsPage } from "pages/number_of_elements.slint";
import { Triangles } from "pages/triangle.slint";
import { ForceCalculator } from "pages/force_calculator.slint";
import { MessageBox } from "./components/message_box.slint";
import { Voronoi } from "./pages/voronoi.slint";
import { BomCalculator, BomRow } from "./pages/bom_caluclator.slint";
import { OfertaPage } from "./pages/oferta.slint";
import { Backend, OfertaState, OfertaItem } from "./globals.slint";
export { Backend, OfertaState, OfertaItem }
export struct PrinterItem {
    name: string,
    is_selected: bool,
}

export enum PrintOrientation { portrait, landscape }

export component AppWindow inherits Window {
    title: "CAD Helper 3D";
    default-font-family: "Sans Serif";

    icon: @image-url("assets/images/ico.png");
    maximized: false;

    preferred-width: 1000px;
    preferred-height: 700px;

    // Global Properties to be sent to rust
    //                  ###

    // Object Distance Calculator
    in-out property <string> computed-distance;
    in-out property <string> computed-center-distance;

    // Right Angle Calculator
    in-out property <string> computed-hypotenuse-text: "";
    in-out property <string> computed-cathetus1-text: "";
    in-out property <string> computed-cathetus2-text: "";
    in-out property <string> computed-abc-angle: "";
    in-out property <string> computed-acb-angle: "";

    //Is Calculator
    in-out property <string> computed-ab-text;
    in-out property <string> computed-bc-text;
    in-out property <string> computed-abc-is-angle;
    in-out property <string> computed-bac-is-angle;

    //Force Calculator
    in property <[string]> force-unit-options;
    in property <[string]> mass-unit-options;
    in property <[string]> area-unit-options;
    in-out property <string> computed-force;
    in-out property <string> computed-mpa;

    //Messages
    in-out property <int> message-type: 0;
    in-out property <string> message-text:"";
    in-out property <bool> show-message-box: false;
    //                  ###

    //Printing
    in-out property <[PrinterItem]> printers-list;
    in-out property <string> active-printer: "";
    in-out property <PrintOrientation> print-orientation: PrintOrientation.landscape;
    //                  ###

    //Voronoi
    in-out property <[string]> voronoi-cells;
    //                  ###

    //BOM Calculator
    in-out property <[BomRow]> bom-rows;
    in-out property <string> bom-loaded-file-name;
    //                  ###


    callback calculate-distance(string, string, string);
    callback calculate-triangle(string, string, string, string, string);
    callback calculate-force(string, string, string, string, string);
    callback calculate-isosceles-tringle(string, string, string, string);
    callback sync-metal-data();
    callback trigger-backend-message(int, string);
    callback select-printer(string);
    callback open-file-dialog(string);
    callback calculate-voronoi(string, string, float, float, float);
    callback export-dxf(string, string, float, float, float);
    callback upload-bom-spreadsheet();
    callback open-directory();

    trigger-backend-message(type, text) => {
        root.message-type = type;
        root.message-text = text;
        show-message-box = true;

        hide-timer.running = true;
    }

    hide-timer := Timer {
        interval: 2s;
        running: false;
        triggered() => {
            root.show-message-box = false;
            self.running = false;
        }
    }

    MenuBar {
        Menu {
            title: "Files";
            MenuItem {
                title: "Files";
                activated => {
                    root.open-file-dialog(root.active-printer);
                }
            }

            MenuSeparator { }

            Menu {
                title: "Printers";
                for printer in root.printers-list: MenuItem {
                    title: printer.name;
                    checkable: true;
                    activated => {
                        root.active-printer = printer.name;
                        root.select-printer(printer.name);
                    }
                    checked: printer.is_selected;
                }
            }

            Menu {
                title: "Orientation";
                MenuItem {
                    title: "Portrait";
                    checkable: true;
                    checked: root.print-orientation == PrintOrientation.portrait;
                    activated => { root.print-orientation = PrintOrientation.portrait; }
                }

                MenuItem {
                    title: "Landscape";
                    checkable: true;
                    checked: root.print-orientation == PrintOrientation.landscape;
                    activated => { root.print-orientation = PrintOrientation.landscape; }
                }
            }
        }

        Menu {
            title: "Generate";
            MenuItem {
                title: "Generate Excel";
                activated => {
                    root.open-directory();
                }
            }
        }
    }

    HorizontalLayout {
        side-bar := SideBar {
            accessible-role: navigation;
            accessible-label: "Sidebar";
            model: [
                "Number of elements",
                "Triangles",
                "Force Calculator",
                "Voronoi",
                "BOM Calculator",
                "Price Offer"
            ];
        }

        VerticalLayout {
            accessible-role: main;
            accessible-label: "Content";

            if(side-bar.current-item == 0): NumberOfElementsPage {

                sync-db => { root.sync-metal-data(); }

                distance: root.computed-distance;
                center-distance: root.computed-center-distance;
                submit_values(total, thickness, count) => {
                    root.calculate-distance(total, thickness, count);
                }
            }
            if(side-bar.current-item == 1): Triangles {

                sync-db => { root.sync-metal-data(); }

                hypotenuse-text <=> root.computed-hypotenuse-text;
                cathetus1-text <=> root.computed-cathetus1-text;
                cathetus2-text <=> root.computed-cathetus2-text;
                abc-angle <=> root.computed-abc-angle;
                acb-angle <=> root.computed-acb-angle;

                calculate_triangle(hypotenuse, cathetus1, cathetus2, abc, acb) => {
                    root.calculate-triangle(hypotenuse, cathetus1, cathetus2, abc, acb);
                }

                ab-text: root.computed-ab-text;
                bc-text: root.computed-bc-text;
                abc-is-angle: computed-abc-is-angle;
                bac-is-angle: computed-bac-is-angle;

                calculate-isosceles-tringle(ab, bc, abc, bac) => {
                    root.calculate-isosceles-tringle(ab, bc, abc, bac);
                }
            }
            if(side-bar.current-item == 2): ForceCalculator {

                sync-db => { root.sync-metal-data(); }

                force-unit-options: root.force-unit-options;
                mass-unit-options: root.mass-unit-options;
                area-unit-options: root.area-unit-options;

                computed-force <=> root.computed-force;
                computed-mpa <=> root.computed-mpa;

                calculate-force(mass, mass_unit, export_unit, area, area_unit) => {
                    root.calculate-force(mass, mass_unit, export_unit, area, area_unit);
                }
            }
            if(side-bar.current-item == 3): Voronoi {
                voronoi-cells <=> root.voronoi-cells;
                submit-voronoi(width, height, seed, space, min_edge) => {
                    root.calculate-voronoi(width, height, seed, space, min_edge);
                }
                request-export-dxf(w, h, seed, space, min-edge) => {
                    root.export-dxf(w, h, seed, space, min-edge);
                }
            }
            if(side-bar.current-item == 4): BomCalculator {
                bom-rows <=> root.bom-rows;
                loaded-file-name <=> root.bom-loaded-file-name;
                upload-spreadsheet => {
                    root.upload-bom-spreadsheet();
                }
            }
            // State lives in the OfertaState global, so nothing to forward here.
            if(side-bar.current-item == 5): OfertaPage { }
        }
    }

    if show-message-box: MessageBox {
        x: (root.width - 300px) / 2;
        y: (root.height - 150px) / 2;
        background: black;
        message-text: root.message-text;
        message-type: root.message-type;
        accepted => { root.show-message-box = false; }
        rejected => { root.show-message-box = false; }
    }
}

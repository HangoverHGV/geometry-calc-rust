# Maintainer: HangoverHGV
pkgname=cad-helper-3d
pkgver=1.0.0
pkgrel=1
pkgdesc="A sleek geometry and spacer calculator helper built with Rust and Slint UI."
arch=('x86_64')
url="https://github.com/HangoverHGV/geometry-calc-rust"
license=('MIT')
depends=('fontconfig' 'libxcb' 'libxkbcommon')
# Added cmake, clang, and go - required by aws-lc-sys to compile its C/Assembly code
makedepends=('rust' 'cargo' 'cmake' 'clang' 'go')
# Added !lto to prevent Arch from stripping cryptography symbols
options=('!debug' '!lto')

source=()
sha256sums=()

package() {
  # Change directory to the project root
  cd "$startdir/../.."

  echo "📦 Packaging the application for the system..."

  # 1. Install the compiled binary into the system binary path
  install -Dm755 "target/release/cad-helper-3d" "${pkgdir}/usr/bin/cad-helper-3d"

  # 2. Install your custom app icon using the new name
  install -Dm644 "ui/assets/images/ico.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/cad-helper-3d.svg"

  # 3. Generate and install the desktop launcher shortcut pointing to the new binary and icon
  echo -e "[Desktop Entry]\nName=Inventor Calculator Helper\nExec=cad-helper-3d\nIcon=cad-helper-3d\nType=Application\nTerminal=false\nCategories=Utility;Math;Science;" > "cad-helper-3d.desktop"
  install -Dm644 "cad-helper-3d.desktop" "${pkgdir}/usr/share/applications/cad-helper-3d.desktop"

  # Clean up the temporary local desktop file
  rm "cad-helper-3d.desktop"
}
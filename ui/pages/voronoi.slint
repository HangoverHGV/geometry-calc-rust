import { Page } from "../components/page.slint";
import { AppStyles } from "../assets/styles.slint";
import { HorizontalBox, GroupBox, LineEdit, Button, Palette } from "std-widgets.slint";
import { LabeledSlider } from "../components/label_slider.slint";

export component Voronoi inherits Page {
    title: "Voronoi Generator";

    out property <float> active-seed;
    out property <float> space-between-cells;
    out property <float> min-cells-edge;

    in property <[string]> voronoi-cells;

    callback submit-voronoi(string, string, float, float, float);
    callback request-export-dxf(string, string, float, float, float);

    function do_submit() {
        root.submit-voronoi(
            width-input.text,
            height-input.text,
            root.active-seed,
            root.space-between-cells,
            root.min-cells-edge
        );
    }

    function do_export() {
        root.request-export-dxf(
            width-input.text,
            height-input.text,
            root.active-seed,
            root.space-between-cells,
            root.min-cells-edge
        );
    }

    changed active-seed => { root.do_submit(); }
    changed space-between-cells => { root.do_submit(); }
    changed min-cells-edge => { root.do_submit(); }

    VerticalLayout {
        spacing: 10px;

        GroupBox {
            title: "Parameters";
            vertical-stretch: 0;

            VerticalLayout {
                HorizontalBox {
                    Text {
                        text: "Width (mm)";
                        font-family: AppStyles.app-font-family;
                        font-size: AppStyles.app-font-size;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                        vertical-alignment: center;
                    }

                    // Renamed from `width` — that name collides with every
                    // element's built-in geometry property.
                    width-input := LineEdit {
                        placeholder-text: "0.0";
                        text: "";
                        input-type: decimal;
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-italic: AppStyles.app-font-italic;
                        edited => { root.do_submit(); }
                        accepted => { root.do_submit(); }
                    }
                }

                HorizontalBox {
                    Text {
                        text: "Height (mm)";
                        font-family: AppStyles.app-font-family;
                        font-size: AppStyles.app-font-size;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                        vertical-alignment: center;
                    }

                    height-input := LineEdit {
                        placeholder-text: "0.0";
                        text: "";
                        input-type: decimal;
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-italic: AppStyles.app-font-italic;
                        edited => { root.do_submit(); }
                        accepted => { root.do_submit(); }
                    }
                }

                LabeledSlider {
                    title: "Seed";
                    minimum: 0;
                    maximum: 200;
                    value <=> root.active-seed;
                }

                LabeledSlider {
                    title: "Space between cells";
                    minimum: 0;
                    maximum: 500;
                    value <=> root.space-between-cells;
                }

                // Capped at 10: this filters on cell VERTEX COUNT, and real
                // Voronoi cells almost never have more than ~10 vertices.
                // A higher max would silently blank the whole preview.
                LabeledSlider {
                    title: "Min cell edges";
                    minimum: 0;
                    maximum: 10;
                    value <=> root.min-cells-edge;
                }

                HorizontalBox {
                    alignment: end;

                    Button {
                        text: "Export DXF...";
                        primary: true;
                        // Disabled until there's something worth exporting.
                        enabled: root.voronoi-cells.length > 0;
                        clicked => { root.do_export(); }
                    }
                }
            }
        }

        GroupBox {
            title: "Live Preview";
            vertical-stretch: 1;

            Rectangle {
                background: Palette.background.darker(0.1);
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                clip: true;

                // The viewbox is essential: without it every Path independently
                // scales its own commands to fill the element, so all cells end
                // up stacked on top of each other at full size instead of
                // tiling. A shared mm-space viewbox puts them in one coordinate
                // system.
                for cell-path in root.voronoi-cells: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: Math.max(width-input.text.to-float(), 1);
                    viewbox-height: Math.max(height-input.text.to-float(), 1);
                    commands: cell-path;
                    fill: Palette.background;
                    stroke: Palette.foreground;
                    stroke-width: 1px;
                }

                if (root.voronoi-cells.length == 0) : Text {
                    text: "Enter dimensions to generate preview...";
                    color: Palette.foreground.darker(0.5);
                    font-size: AppStyles.app-font-size;
                    font-family: AppStyles.app-font-family;
                }
            }
        }
    }
}

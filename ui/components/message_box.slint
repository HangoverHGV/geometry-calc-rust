import { MessageStyle } from "../assets/styles.slint";
import { VerticalBox, StandardButton, HorizontalBox } from "std-widgets.slint";

export component MessageBox inherits Rectangle {
    in property <int> message-type; // 0 - info; 1 - warn; 2 - error
    in property <string> message-text;
    in property <image> type-image;

    width: 300px;
    height: 150px;

    callback accepted();
    callback rejected();

    property <color> icon-color:
        message-type == 0 ? MessageStyle.info-color :
        message-type == 1 ? MessageStyle.warning-color :
        MessageStyle.error-color;
    property <image> sign-image:
        message-type == 0 ? MessageStyle.info-image :
        message-type == 1 ? MessageStyle.warning-image :
        MessageStyle.error-image;

    VerticalBox {
        alignment: start;
        HorizontalBox {
            alignment: start;
            Image {
                width: 100px;
                source: sign-image;
                colorize: icon-color;
            }
            Text {
                vertical-alignment: center;
                horizontal-alignment: start;
                wrap: word-wrap;
                text: message-text;
                font-family: MessageStyle.app-font-family;
                font-size: MessageStyle.message-font-size;
                color: white;
            }
        }

        HorizontalBox {

            StandardButton {
                kind: ok;
                clicked => { root.accepted(); }
            }

            StandardButton {
                kind: cancel;
                clicked => { root.rejected(); }
            }
        }
    }
}

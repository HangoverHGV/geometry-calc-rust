import {
    Switch,
    HorizontalBox,
    VerticalBox,
    Palette,
    SpinBox,
    Button,
    TimePickerPopup,
} from "std-widgets.slint";
import { AppStyles } from "../assets/styles.slint";
import { Backend } from "../globals.slint";
import { ClearButton } from "./clear_button.slint";

export component Page inherits VerticalBox {
    in property <string> title: "title";
    in property <string> description: "description";
    in property <bool> show-enable-switch: true;
    in property <bool> show-enable-read-only: false;
    in-out property <int> font-size-value: AppStyles.app-font-size / 1px;

    property <image> sync-icon: @image-url("../assets/images/sync.svg");

    accessible-role: tab-panel;
    accessible-label: root.title;

    callback sync-db();
    callback shutdown-at(int, int, int);

    HorizontalBox {
        Text {
            font-size: 20px;
            text <=> root.title;
        }

        Button {
            horizontal-stretch: 0;
            text: "Sync";
            icon: sync-icon;
            primary: true;
            clicked => {
                sync-db();
            }
        }

        // Spacer
        Rectangle { }

        Switch {
            horizontal-stretch: 0;
            text: @tr("Dark Mode");
            checked: Palette.color-scheme == ColorScheme.dark;
            toggled => {
                Palette.color-scheme = self.checked ? ColorScheme.dark : ColorScheme.light;
            }
        }

        SpinBox {
            minimum: 10;
            maximum: 32;
            value: root.font-size-value;
            horizontal-stretch: 0;
            edited(value) => {
                root.font-size-value = self.value;
                AppStyles.app-font-size = self.value * 1px;
            }
        }


        if !Backend.shutdown-pending: ClearButton {
            text: "Shutdown";
            background: #ff0800;
            clicked => {
                time-picker.show();
            }
        }

        shutdown-timer := Timer {
            interval: 1s;
            running: Backend.shutdown-pending;
            triggered() => {
                Backend.shutdown-remaining -= 1;
            }
        }
        if Backend.shutdown-pending: Text {
            horizontal-stretch: 0;
            vertical-alignment: center;
            text: "Shutdown in " + Backend.remaining-text;
            color: #d9534f;
            font-size: AppStyles.app-font-size;
        }

        if Backend.shutdown-pending: Button {
            horizontal-stretch: 0;
            text: "Cancel Shutdown";
            clicked => {
                Backend.cancel-shutdown();
            }
        }

        time-picker := TimePickerPopup {
            use-24-hour-format: true;
            time: { hour: 1, minute: 0, second: 0 };
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 360px;
            height: 524px;
            canceled => {
                time-picker.close();
            }

            accepted(time) => {
                Backend.schedule-shutdown(time.hour * 3600 + time.minute * 60 + time.second );
                time-picker.close();
            }
        }
    }

    @children
}

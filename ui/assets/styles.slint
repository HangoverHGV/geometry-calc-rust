export global AppStyles{
    in-out property <length> app-font-size: 16px;
    in-out property <string> app-font-family: "Sans Serif";
    in-out property <float> app-font-weight: 400;
    in-out property <bool> app-font-italic: false;
    out property <length> default-spacing: 5px;
    out property <length> default-padding: 10px;
 }
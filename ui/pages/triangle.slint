import { Page } from "../components/page.slint";
import {
    GroupBox,
    TabWidget,
    VerticalBox,
    LineEdit,
    HorizontalBox,
    Button,
} from "std-widgets.slint";
import { AppStyles } from "../assets/styles.slint";
import { ClearButton } from "../components/clear_button.slint";



export component Triangles inherits Page {
    title: "Triangle Calculator";

    property <image> right-triangle-svg: @image-url("../assets/images/right-triangle.svg");
    property <image> is-triangle-svg: @image-url("../assets/images/isosceles-triangle.svg");

    callback calculate_triangle(string, string, string, string, string);
    callback calculate-isosceles-tringle(string, string, string, string);

    // 1. INPUT PROPERTIES: Keep track of ONLY what the user types
    property <string> input-hypotenuse: "";
    property <string> input-cathetus1: "";
    property <string> input-cathetus2: "";
    property <string> input-abc-angle: "";
    property <string> input-acb-angle: "";

    property <string> input-ab-text: "";
    property <string> input-bc-text: "";
    property <string> input-abc-is-angle: "";
    property <string> input-bac-is-angle: "";

    // 2. RESULT PROPERTIES: Updated exclusively by your Rust code
    in-out property <string> hypotenuse-text: "";
    in-out property <string> cathetus1-text: "";
    in-out property <string> cathetus2-text: "";
    in-out property <string> abc-angle: "";
    in-out property <string> acb-angle: "";

    in-out property <string> ab-text: "";
    in-out property <string> bc-text: "";
    in-out property <string> abc-is-angle: "";
    in-out property <string> bac-is-angle: "";

    // Send what the user is typing to Rust
    function do_calculate_right_angle() {
        root.calculate_triangle(input-hypotenuse, input-cathetus1, input-cathetus2, input-abc-angle, input-acb-angle);
    }

    function do_calculate_is() {
        root.calculate-isosceles-tringle(input-ab-text, input-bc-text, input-abc-is-angle, input-bac-is-angle);
    }

    GroupBox {
        TabWidget {
            Tab {
                title: "Right angle";

                VerticalBox {
                    HorizontalBox {
                        alignment: start;
                        padding: 0px;
                        spacing: 5px;

                        ClearButton {
                            text: "Clear";
                            clicked => {
                                root.input-hypotenuse = "";
                                root.input-cathetus1 = "";
                                root.input-cathetus2 = "";
                                root.input-abc-angle = "";
                                root.input-acb-angle = "";

                                root.hypotenuse-text = "";
                                root.cathetus1-text = "";
                                root.cathetus2-text = "";
                                root.abc-angle = "";
                                root.acb-angle = "";

                                root.do_calculate_right_angle();
                            }
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        VerticalBox {
                            alignment: start;
                            Text {
                                text: "Hypotenuse BC";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-hypotenuse;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_right_angle(); }
                            }

                            Text {
                                text: "Cathetus 1 AB: ";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-cathetus1;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_right_angle(); }
                            }

                            Text {
                                text: "Cathetus 2 AC";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-cathetus2;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_right_angle(); }
                            }
                        }

                        VerticalBox {
                            alignment: start;
                            Text {
                                text: "ABC angle:";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-abc-angle;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_right_angle(); }
                            }

                            Text {
                                text: "ACB angle:";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-acb-angle;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_right_angle(); }
                            }
                        }

                        Image {
                            horizontal-alignment: ImageHorizontalAlignment.center;
                            source: right-triangle-svg;
                            height: 300px;
                            width: 400px;
                        }
                    }

                    HorizontalBox {
                        VerticalBox {
                            Text {
                                text: "Hypotenuse BC: " + root.hypotenuse-text + " mm";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "Cathetus 1 AB: " + root.cathetus1-text + " mm";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "Cathetus 2 AC: " + root.cathetus2-text + " mm";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }
                        }

                        VerticalBox {
                            Text {
                                text: "Angle ABC: " + root.abc-angle + "°";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "Angle ACB: " + root.acb-angle + "°";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Isosceles";

                // A Tab stacks its children at the same origin instead of
                // laying them out, so EVERYTHING in the tab has to live inside
                // this one VerticalBox. Closing it early is what put the Clear
                // button on top of the results text.
                VerticalBox {
                    HorizontalBox {
                        alignment: start;
                        padding: 0px;
                        spacing: 5px;

                        ClearButton {
                            text: "Clear";
                            clicked => {
                                root.input-ab-text = "";
                                root.input-bc-text = "";
                                root.input-abc-is-angle = "";
                                root.input-bac-is-angle = "";

                                root.ab-text = "";
                                root.bc-text = "";
                                root.abc-is-angle = "";
                                root.bac-is-angle = "";

                                root.do_calculate_is();
                            }
                        }
                    }

                    HorizontalBox {
                        alignment: start;
                        VerticalBox {
                            alignment: start;
                            Text {
                                text: "AB:";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-ab-text;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_is(); }
                            }

                            Text {
                                text: "BC";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-bc-text;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_is(); }
                            }
                        }

                        VerticalBox {
                            alignment: start;
                            Text {
                                text: "ABC";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-abc-is-angle;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_is(); }
                            }

                            Text {
                                text: "BAC";
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            LineEdit {
                                placeholder-text: "0.0";
                                text <=> root.input-bac-is-angle;
                                input-type: decimal;
                                font-size: AppStyles.app-font-size;
                                font-family: AppStyles.app-font-family;
                                font-italic: AppStyles.app-font-italic;
                                edited => { root.do_calculate_is(); }
                            }
                        }

                        Image {
                            horizontal-alignment: ImageHorizontalAlignment.center;
                            source: is-triangle-svg;
                            height: 300px;
                            width: 300px;
                        }
                    }

                    HorizontalBox {
                        VerticalBox {
                            // AB and AC are the two equal legs, so both read
                            // from ab-text by design.
                            Text {
                                text: "AB: " + root.ab-text + " mm";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "AC: " + root.ab-text + " mm";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "BC: " + root.bc-text + " mm";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }
                        }

                        VerticalBox {
                            // ABC and ACB are the equal base angles.
                            Text {
                                text: "Angle ABC: " + root.abc-is-angle + "°";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "Angle ACB: " + root.abc-is-angle + "°";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }

                            Text {
                                text: "Angle BAC: " + root.bac-is-angle + "°";
                                font-size: AppStyles.app-font-size + 3px;
                                font-family: AppStyles.app-font-family;
                                font-weight: AppStyles.app-font-weight;
                                font-italic: AppStyles.app-font-italic;
                            }
                        }
                    }
                }
            }
        }
    }
}

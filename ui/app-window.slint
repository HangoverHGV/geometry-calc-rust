import { SideBar } from "side_bar.slint";
import { NumberOfElementsPage } from "number_of_elements.slint";
import { Triangles } from "triangle.slint";
import { ForceCalculator} from "force_calculator.slint";

export component AppWindow inherits Window {
    title: "Inventor Calculator Helper";

    icon: @image-url("images/ico.svg");
    maximized: true;
    
    preferred-width: 1000px;
    preferred-height: 500px;

    // Global Properties to be sent to rust 
    //                  ###

    // Object Distance Calculator
    in-out property <string> computed-distance;
    in-out property <string> computed-center-distance;

    // Right Angle Calculator
    in-out property <string> computed-hypotenuse-text: "";
    in-out property <string> computed-cathetus1-text: "";
    in-out property <string> computed-cathetus2-text: "";
    in-out property <string> computed-abc-angle: "";
    in-out property <string> computed-acb-angle: "";

    //Force Calculator
    in property <[string]> force-unit-options;
    in property <[string]> mass-unit-options;
    in property <[string]> area-unit-options;
    in-out property <string> computed-force;
    in-out property <string> computed-mpa;

    //                  ###

    callback calculate-distance(string, string, string);
    callback calculate-triangle(string, string, string, string, string);
    callback calculate-force(string, string, string, string, string);

    HorizontalLayout {
        side-bar := SideBar {
            accessible-role: navigation;
            accessible-label: "Sidebar";
            model: [
                "Number of elements",
                "Triangles",
                "Force Calculator"
            ];
        }
        VerticalLayout {
            accessible-role: main;
            accessible-label: "Content";

            if(side-bar.current-item == 0): NumberOfElementsPage {
                distance: root.computed-distance;
                center-distance: root.computed-center-distance;
                submit_values(total, thickness, count) => {
                    root.calculate-distance(total, thickness, count);
                }
            }
            if(side-bar.current-item == 1): Triangles {
                hypotenuse-text <=> root.computed-hypotenuse-text;
                cathetus1-text <=> root.computed-cathetus1-text;
                cathetus2-text <=> root.computed-cathetus2-text;
                abc-angle <=> root.computed-abc-angle;
                acb-angle <=> root.computed-acb-angle;
                
                calculate_triangle(hypotenuse, cathetus1, cathetus2, abc, acb) => {
                    root.calculate-triangle(hypotenuse, cathetus1, cathetus2, abc, acb);
                }
            }
            if(side-bar.current-item ==2): ForceCalculator {
                force-unit-options: root.force-unit-options;
                mass-unit-options: root.mass-unit-options;
                area-unit-options: root.area-unit-options;

                computed-force <=> root.computed-force;
                computed-mpa <=> root.computed-mpa;

                calculate-force(mass, mass_unit, export_unit, area, area_unit) => {
                    root.calculate-force(mass, mass_unit, export_unit, area, area_unit);
                }
            } 
        }
    }
}
import {
    Button,
    GroupBox,
    VerticalBox,
    LineEdit,
    HorizontalBox,
} from "std-widgets.slint";

import { Page } from "../components/page.slint";
import { AppStyles } from "../assets/styles.slint";
import { ClearButton } from "../components/clear_button.slint";

export component NumberOfElementsPage inherits Page {
    title: "Number Of Elements";

    in-out property <string> center-distance: "0";
    in-out property <string> distance: "0";
    callback submit_values(string, string, string);

    property <image> center-image: @image-url("../assets/images/circle.svg");
    property <image> edge-image: @image-url("../assets/images/edge.svg");

    property <length> max-image-wdth: 400px;
    property <length> max-iamge-height: 200px;

    // Main calculation function
    function do_calculate() {
        root.submit_values(total_distance.text, thickness.text, number_of_objects.text);
    }

    GroupBox {

        VerticalBox {
            spacing: 3px;
            alignment: start;
            padding: 10px;

            HorizontalBox {
                alignment: start;
                padding: 0px;
                spacing: 5px;


                ClearButton {
                    text: "Clear";
                    clicked => {
                        total_distance.text = "";
                        thickness.text = "";
                        number_of_objects.text = "";
                        root.do_calculate();
                    }
                }
            }

            Text {
                text: "Total Distance (mm): ";
                font-size: AppStyles.app-font-size;
                font-family: AppStyles.app-font-family;
                font-weight: AppStyles.app-font-weight;
                font-italic: AppStyles.app-font-italic;
            }

            total_distance := LineEdit {
                placeholder-text: "0.0";
                text: "";
                input-type: decimal;
                font-size: AppStyles.app-font-size;
                font-family: AppStyles.app-font-family;
                font-italic: AppStyles.app-font-italic;
                edited => { root.do_calculate(); }
                accepted => { root.do_calculate(); }
            }

            Text {
                text: "Object Thickness (mm): ";
                font-size: AppStyles.app-font-size;
                font-family: AppStyles.app-font-family;
                font-weight: AppStyles.app-font-weight;
                font-italic: AppStyles.app-font-italic;
            }

            thickness := LineEdit {
                placeholder-text: "0.0";
                text: "";
                input-type: decimal;
                font-size: AppStyles.app-font-size;
                font-family: AppStyles.app-font-family;
                font-italic: AppStyles.app-font-italic;
                edited => { root.do_calculate(); }
                accepted => { root.do_calculate(); }
            }

            Text {
                text: "Number of Objects (mm): ";
                font-size: AppStyles.app-font-size;
                font-family: AppStyles.app-font-family;
                font-weight: AppStyles.app-font-weight;
                font-italic: AppStyles.app-font-italic;
            }

            number_of_objects := LineEdit {
                placeholder-text: "0";
                text: "";
                input-type: number;
                font-size: AppStyles.app-font-size;
                font-family: AppStyles.app-font-family;
                font-italic: AppStyles.app-font-italic;
                edited => { root.do_calculate(); }
                accepted => { root.do_calculate(); }
            }
        }
    }

    GroupBox {
        HorizontalLayout {
            VerticalBox {
                Image {
                    source: edge-image;
                    max-width: max-image-wdth;
                    max-height: max-iamge-height;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Distance from the edge: " + root.distance + " mm";
                    font-size: AppStyles.app-font-size + 5px;
                    font-family: AppStyles.app-font-family;
                    font-weight: AppStyles.app-font-weight;
                    font-italic: AppStyles.app-font-italic;
                }
            }

            VerticalBox {
                Image {
                    source: center-image;
                    max-width: max-image-wdth;
                    max-height: max-iamge-height;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Distance from the center: " + root.center-distance + " mm";
                    font-size: AppStyles.app-font-size + 5px;
                    font-family: AppStyles.app-font-family;
                    font-weight: AppStyles.app-font-weight;
                    font-italic: AppStyles.app-font-italic;
                }
            }
        }
    }
}

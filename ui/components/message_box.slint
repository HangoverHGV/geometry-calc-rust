import  { MessageStyle } from "../assets/styles.slint";
import { HorizontalBox } from "std-widgets.slint";

export component MessageBox {
    in property <int> message-type; //0 - info; 1 - warn; 2 - error
    in property <string> message-text;
    in property <image> type-image;
    property <color> icon-color:
        message-type == 0 ? MessageStyle.info-color :
        message-type == 1 ? MessageStyle.warning-color :
        MessageStyle.error-color;

    Rectangle {
        HorizontalBox {
            Text {
                text: message-text;
                font-family: MessageStyle.app-font-family;
                font-size: MessageStyle.message-font-size;
            }
        }
     }
}

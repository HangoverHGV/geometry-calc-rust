import {
    Button,
    GroupBox,
    VerticalBox,
    LineEdit,
    HorizontalBox,
    ComboBox,
    Palette,
} from "std-widgets.slint";
import { AppStyles } from "../assets/styles.slint";

import { Page } from "../components/page.slint";
import { ClearButton } from "../components/clear_button.slint";

export component ForceCalculator inherits Page {
    title: "Force Elements";
    // 1. Data arrays passed down from AppWindow
    in property <[string]> force-unit-options;
    in property <[string]> mass-unit-options;
    in property <[string]> area-unit-options;

    // 2. Outgoing computed results
    in property <string> computed-force;
    in property <string> computed-mpa;

    // 3. Callback to execute the Rust calculation
    callback calculate-force(string, string, string, string, string);
    // Main calculation function
    function do_calculate() {
        root.calculate-force(mass.text, mass_unit.current-value, export_unit.current-value, area.text, area_unit.current-value);
    }

    GroupBox {

        VerticalBox {
            spacing: 3px;
            alignment: start;
            padding: 10px;

            HorizontalBox {
                alignment: start;
                padding: 0px;
                spacing: 5px;

               ClearButton {
                   text: "Clear";
                   clicked => {
                           mass.text = "";
                           area.text = "1";
                           root.do_calculate();
                       }
               }
            }

            HorizontalBox {
                VerticalBox {
                    Text {
                        text: "Mass";
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                    }

                    mass := LineEdit {
                        placeholder-text: "0.0";
                        text: "";
                        input-type: decimal;
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-italic: AppStyles.app-font-italic;
                        // This fires on every single keystroke change!
                        edited => { root.do_calculate(); }
                        accepted => { root.do_calculate(); }
                    }
                }

                VerticalBox {
                    Text {
                        text: "Unit";
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                    }

                    mass_unit := ComboBox {
                        model: root.mass-unit-options;
                        selected => {
                            root.do_calculate()
                        };
                        height: 30px;
                    }
                }
            }

            HorizontalBox {
                VerticalBox {
                    Text {
                        text: "Area (" + area_unit.current-value + ")";
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                    }

                    area := LineEdit {
                        placeholder-text: "0.0";
                        text: "1";
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-italic: AppStyles.app-font-italic;
                        input-type: decimal;
                        edited => { root.do_calculate(); }
                        accepted => { root.do_calculate(); }
                    }
                }

                VerticalBox {
                    Text {
                        text: "Unit";
                        font-size: AppStyles.app-font-size;
                        font-family: AppStyles.app-font-family;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                    }

                    area_unit := ComboBox {
                        model: root.area-unit-options;
                        selected => {
                            root.do_calculate()
                        };
                        height: 30px;
                    }
                }
            }

            HorizontalBox {
                Text {
                    text: "Convert Unit";
                    font-size: AppStyles.app-font-size;
                    font-family: AppStyles.app-font-family;
                    font-weight: AppStyles.app-font-weight;
                    font-italic: AppStyles.app-font-italic;
                }

                export_unit := ComboBox {
                    model: root.force-unit-options;
                    selected(current-value) => {
                        root.do_calculate()
                    }
                }
            }

            HorizontalBox {
                Rectangle {
                    background: Palette.color-scheme == ColorScheme.dark ? #3d3636 : #e0e0e0;
                    border-radius: 2px;

                    Text {

                        text: root.computed-force + " " + export_unit.current-value;
                        font-size: AppStyles.app-font-size + 5px;
                        font-family: AppStyles.app-font-family;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                    }
                }

                Rectangle {
                    background: Palette.color-scheme == ColorScheme.dark ? #3d3636 : #e0e0e0;
                    border-radius: 2px;
                    Text {
                        text: root.computed-mpa + " MPa";
                        font-size: AppStyles.app-font-size + 5px;
                        font-family: AppStyles.app-font-family;
                        font-weight: AppStyles.app-font-weight;
                        font-italic: AppStyles.app-font-italic;
                    }
                }
            }
        }
    }
}
